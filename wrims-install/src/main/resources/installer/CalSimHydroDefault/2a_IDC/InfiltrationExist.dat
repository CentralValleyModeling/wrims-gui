C*******************************************************************************
C
C                          IWFM DEMAND CALCULATOR (IDC)
C                              *** Version 2.1 ***
C
C*******************************************************************************
C
C                  INFILTRATION DATA FILE
C
C
C             Project : CALSIM 3.0 Development                         
C             Filename: Infiltration.dat                         
C
C*******************************************************************************
C                              File Description:
C
C   This data file contains the time-series data for the infiltration of  
C   precipitaion.
C
C*******************************************************************************
C                         Infiltration Data Specifications
C
C   NFILT   ;  Number of infiltration data columns
C   FACTFILT;  Conversion factor for the rate of infiltration due to precipitation 
C               It is used to convert only the length component of the unit; 
C               DO NOT include the conversion factor for time component of the unit.
C               * e.g. Unit of infiltration rate listed in this file = INCHES/MONTH
C                      Consistent unit used in simulation            = FEET/DAY 
C                      Enter FACTFILT (INCHES/MONTH -> FEET/MONTH)   = 8.33333E-02 
C                       (conversion of MONTH -> DAY is performed automatically)
C
C-------------------------------------------------------------------------------     
C ITFILT    RFILTRN(1)  RFILTRN(2)  RFILTRN(3) ...  RFILTRN(NFILT) 
C 
C   DSSFL   ;  The name of the DSS file for data input (maximum 100 characters); 
C               * Leave blank if DSS file is not used for data input
C
C-------------------------------------------------------------------------------
C         VALUE                                      DESCRIPTION
C-------------------------------------------------------------------------------
            880                                      / NFILT
     8.33333E-02                                     / FACTFILT   
     UnitInfOutput.dss                            / DSSFL
C-------------------------------------------------------------------------------
C                           Infiltration Data 
C                         (READ FROM THIS FILE)
C
C   List the infiltration rates below, if it will not be read from  
C   a DSS file (i.e. DSSFL is left blank above).
C
C   ITFILT ;   Time 
C   RFILTRN;   Infiltration rate; [L/T]
C-------------------------------------------------------------------------------
*
*
C-------------------------------------------------------------------------------
