C*
C----------------------------------------------------------------------------------------
C                              Pathnames for Land Use Data
C                                (READ FROM DSS FILE)
C
C   List the pathnames for the land use data below, if it will be read from a DSS file
C   (i.e. DSSFL is specified above).
C
C   The pathnames should be listed for each subregion and land use type combination.
C   They should be listed in an order such that, the land use type changes first.
C
C   * Example:
C
C       IREGN     CRTYPE        PATH
C        1        1         (pathname[1])			         => Sub-region 1; crop 1
C        1        2         (pathname[2])				 => Sub-region 1; crop 2
C        1        3         (pathname[3])				 => Sub-region 1; crop 3
C        .        .               .					       .
C        .        .               .					       .
C        .        .               .					       .
C        1        NCROP     (pathname[NCROP])				 => Sub-region 1; crop NCROP
C        1        NCROP+1   (pathname[NCROP+1])				 => Sub-region 1; urban
C        1        NCROP+2   (pathname[NCROP+2])				 => Sub-region 1; native vegetation
C        2        1         (pathname[NCROP+3])				 => Sub-region 2; crop 1
C        2        2         (pathname[NCROP+4])				 => Sub-region 2; crop 2
C        2        3         (pathname[NCROP+5])				 => Sub-region 2; crop 3
C        .        .               .					       .
C        .        .               .					       .
C        .        .               .					       .
C        2        NCROP     (pathname[2*NCROP+2])			 => Sub-region 2; crop NCROP
C        2        NCROP+1   (pathname[2*NCROP+3])			 => Sub-region 2; urban
C        2        NCROP+2   (pathname[2*NCROP+4])			 => Sub-region 2; native vegetation
C        .        .               .					       .
C        .        .               .					       .
C        .        .               .					       .
C        NREGN    1         (pathname[(NREGN-1)*(NCROP+2)+1])		 => Sub-region NREGN; crop 1
C        NREGN    2         (pathname[(NREGN-1)*(NCROP+2)+2])		 => Sub-region NREGN; crop 2
C        NREGN    3         (pathname[(NREGN-1)*(NCROP+2)+3])		 => Sub-region NREGN; crop 3
C        .        .              .					       .
C        .        .              .					       .
C        .        .              .					       .
C        NREGN    NCROP     (pathname[(NREGN-1)*(NCROP+2)+NCROP])	 => Sub-region NREGN; crop NCROP
C        NREGN    NCROP+1   (pathname[(NREGN-1)*(NCROP+2)+NCROP+1])	 => Sub-region NREGN; urban
C        NREGN    NCROP+2   (pathname[NREGN*(NCROP+2)])			 => Sub-region NREGN; native vegetation
C
C   IREGN  ;  Sub-region number
C   CRTYPE ;  Crop, non-agricultural land use or bare soil identifier
C   PATH   ;  Pathname corresponding to element and land use type combination
C
C----------------------------------------------------------------------------------------
C   IREGN        CRTYPE        PATH
C----------------------------------------------------------------------------------------
