C*******************************************************************************
C
C                          IWFM DEMAND CALCULATOR (IDC)
C                              *** Version 2.1 ***
C
C*******************************************************************************
C
C                    EVAPOTRANSPIRATION DATA FILE
C
C
C             Project :  CALSIM 3.0 Development
C             Filename:  ET.dat
C
C*******************************************************************************
C                         File Description:
C
C   This data file contains the crop evapotranspiration values under standard
C   conditions (ETc) for each sub-region for each crop and non-agricultural land
C   use type. Evapotranspiration rate of bare soil at each subregion are also
C   listed in this file.
C
C*******************************************************************************
C                     Evapotranspiration Data Specifications
C
C   FACTET;  Conversion factor for evapotranspiration rate
C             It is used to convert only the length component of the unit;
C             DO NOT include the conversion factor for time component of the unit.
C             * e.g. Unit of ET rate listed in this file       = INCHES/MONTH
C                    Consistent unit used in simulation        = FEET/DAY
C                    Enter FACTET (INCHES/MONTH -> FEET/MONTH) = 8.33333E-02
C                     (conversion of MONTH -> DAY is performed automatically)
C   DSSFL ;  The name of the DSS file for data input (maximum 100 characters);
C             * Leave blank if DSS file is not used for data input
C
C-------------------------------------------------------------------------------
C         VALUE                                      DESCRIPTION
C-------------------------------------------------------------------------------
      0.0833333                                      / FACTET (in/mon --> ft/mon)
      .\inputDSS\CS3_ET.dss                       / DSSFL  (DSS input data taken from CalSim-III Hydrology Development Project report Table 10-8 Crop Evapotranspiration)
C-------------------------------------------------------------------------------
C                             Evapotranspiration Data
C                              (READ FROM THIS FILE)
C
C   List the ETc rate for each crop, non-agricultural land use, and soil for each
C   sub-region, if it will not be read from a DSS file (i.e. DSSFL is left
C   blank above).
C
C   ITEV ;   Time
C   IR   ;   Subregion number
C   AEVAP;   Evapotranspiration rate for corresponding land use and sub-region; [L/T]
C             (Include ETc rates for all crop types, non-agricultural land use types and
C              soil evaporation.)
C
C-------------------------------------------------------------------------------
*   Optional: List crop number and corresponding crop types
*
*   Crop/Land Use No.           Name
*   ----------------            ------
*       1                         AL	ALFALFA
*       2                         AP	ALMONDS AND PISTACHIO
*       3                         CO	COTTON
*       4                         CR	CORN
*       5                         CU	CUCURBITS
*       6                         DB	DRY BEANS
*       7                         FI	OTHER FIELD
*       8                         GR	GRAIN
*       9                         OG	ONIONS AND GARLIC
*       10                        OR	OTHER DECID.
*       11                        PA	PASTURE
*       12                        PO	POTATOES
*       13                        RI	RICE
*       14                        SB	SUGAR BEETS
*       15                        SF	SAFFLOWER
*       16                        SO	SUBTROPICAL
*       17                        TH	FRESH TOMATOES
*       18                        TM	PROCESS TOMATOES
*       19                        TR	OTHER TRUCK
*       20                        VI	VINEYARDS
*       21                        UR	urban
*       22                        NV	native veg
*       23                        SL	bare soil
C-------------------------------------------------------------------------------
C ITEV              IR      AEVAP(1)  AEVAP(2)  AEVAP(3) ... AEVAP(16)  AEVAP(17)
C-------------------------------------------------------------------------------
C				AL	AP	CO	CR	CU	DB	FI	GR	OG	OR	PA	PO	RI	SB	SF	SO	TH	TM	TR	VI	UR	NV	SL
* 10/31/4000_24:00     1
* 11/30/4000_24:00     1
* 12/31/4000_24:00     1
* 01/31/4000_24:00     1
* 02/29/4000_24:00     1
* 03/31/4000_24:00     1
* 04/30/4000_24:00     1
* 05/31/4000_24:00     1
* 06/30/4000_24:00     1
* 07/31/4000_24:00     1
* 08/31/4000_24:00     1
* 09/30/4000_24:00     1
C-------------------------------------------------------------------------------
C                             Evapotranspiration Data
C                              (READ FROM DSS FILE)
C
C   List the pathnames for ETc rates for each crop, non-agricultural land use, and
C   bare soil for each sub-region, if it will be read from a DSS file (i.e. DSSFL
C   is specified above).
C
C   The pathnames should be listed for each subregion and crop/land use type combination,
C   Use the following example for the order of pathnames.
C
C   * Example [simulation includes 3 agricultural crops]
C
C       IR     CRTYPE     PATH
C        1       1        (pathname[1])              => Sub-region 1; crop 1
C        1       2        (pathname[2])              => Sub-region 1; crop 2
C        1       3        (pathname[3])              => Sub-region 1; crop 3
C        1       4        (pathname[4])              => Sub-region 1; urban land
C        1       5        (pathname[5])              => Sub-region 1; native veg.
C        1       6        (pathname[6])              => Sub-region 1; bare soil
C        2       1        (pathname[7])              => Sub-region 2; crop 1
C        2       2        (pathname[8])              => Sub-region 2; crop 2
C        2       3        (pathname[9])              => Sub-region 2; crop 3
C        2       4        (pathname[10])             => Sub-region 2; urban land
C        2       5        (pathname[11])             => Sub-region 2; native veg.
C        2       6        (pathname[12])             => Sub-region 2; bare soil
C        .       .             .
C        .       .             .
C        .       .             .
C      NREGN     1        (pathname[(6*NREGN)-5])    => Sub-region NREGN; crop 1
C      NREGN     2        (pathname[(6*NREGN)-4]])   => Sub-region NREGN; crop 2
C      NREGN     3        (pathname[(6*NREGN)-3]])   => Sub-region NREGN; crop 3
C      NREGN     4        (pathname[(6*NREGN)-2]])   => Sub-region NREGN; urban land
C      NREGN     5        (pathname[(6*NREGN)-1]])   => Sub-region NREGN; native veg.
C      NREGN     6        (pathname[(6*NREGN)  ])    => Sub-region NREGN; bare soil
C
C   IR     ;  Subregion number
C   CRTYPE ;  Crop, non-agricultural land use or bare soil identifier
C   PATH   ;  Pathname for the time series record
C
C-----------------------------------------------------------------------------------------------------------
C   IR        CRTYPE        PATH
C-----------------------------------------------------------------------------------------------------------
	1	1	/IWFM/WBA02_AL_ET/RATE_INCH//1MON/EVAPOTRANSPIRATION/
	1	2	/IWFM/WBA02_AP_ET/RATE_INCH//1MON/EVAPOTRANSPIRATION/
