C*******************************************************************************
C
C                          IWFM DEMAND CALCULATOR (IDC)
C                              *** Version 2.1 ***
C
C*******************************************************************************
C
C                            MAIN INPUT FILE
C
C
C             Project :  Calsim 3.0 Hydrology Development
C             Filename:  Main.in
C
C*******************************************************************************
C                              File Description
C
C    This file contains the main simulation control data that includes
C    the names and descriptions of all simulation files; simulation period; output 
C    conversion factors and the codes for the agricultural crops and subregions.
C
C*****************************************************************************
C                            File Description
C
C  *Listed below are all input and output file names used when running the
C   utility.  
C  *Each file name has a maximum length of 100 characters
C  *If a file does not exist for a project, leave the filename blank
C
C-------------------------------------------------------------------------------
C    FILE NAME                                      DESCRIPTION
C---------------------------------------------------------------------------------------------
  .\2a_IDC\INITIAL.DAT  		                             / 1: INITIAL CONDITIONS DATA FILE  (REQUIRED, INPUT)
  .\2a_IDC\PARAMETER.DAT                                         / 2: PARAMETER DATA FILE  (REQUIRED, INPUT)
  .\2a_IDC\ELandUse.dat	                                     / 3: LAND USE DATA FILE (REQUIRED, INPUT)
  .\2a_IDC\OutputPathnames.DAT                                   / 4: STANDARD OUTPUT PATHNAMES DATA FILE  (REQUIRED, INPUT) 
  .\2a_IDC\Precip.dat                                            / 5: PRECIPITATION DATA FILE  (REQUIRED, INPUT)
  .\2a_IDC\InfiltrationExist.dat                                 / 6: INFILTRATION OF PRECIPITATION DATA FILE (OPTIONAL, INPUT)
  .\2a_IDC\MINMOISTURE.DAT                                       / 7: MINIMUM SOIL MOISTURE REQUIREMENT DATA FILE  (REQUIRED, INPUT)
  .\2a_IDC\IrigEfficiency.dat                                    / 8: CROP SEASONAL EFFICIENCY DATA FILE (REQUIRED, INPUT)
  .\2a_IDC\URBANSPEC.DAT                                         / 9: URBAN WATER USE SPECIFICATION DATA FILE  (OPTIONAL, INPUT)
  .\2a_IDC\UrbanDemand.dat                                       /10: URBAN WATER DEMAND FILE  (OPTIONAL, INPUT)
  .\2a_IDC\ET.DAT                                                /11: EVAPOTRANSPIRATION DATA FILE  (REQUIRED, INPUT)
  .\2a_IDC\ReturnFlowFactor.dat                                  /12: RETURN FLOW FRACTION DATA FILE (REQUIRED, INPUT)
  .\2a_IDC\Reuse.dat                                             /13: APPLIED WATER RE-USE FACTOR DATA FILE  (OPTIONAL, INPUT)
  IDCOutput.dss                                                                      /14: STANDARD DSS OUTPUT FILE  (REQUIRED, OUTPUT)
  IDC_BUDGET.DSS                                                                     /15: DSS FILE FOR ROOT ZONE BUDGET  (OPTIONAL, OUTPUT)
/ POTCUAW.DSS     					                             /16: DSS FILE FOR POTENTIAL CUAW OUTPUT (OPTIONAL, OUTPUT)
C*******************************************************************************
C                         Model Simulation Period
C
C   The following lists the simulation beginning time, ending time and time step length.  
C
C   BDT    ; Beginning simulation date and time. Use MM/DD/YYYY_hh:mm format. 
C             * Midnight is 24:00
C   EDT   ; Ending simulation date and time.  Use MM/DD/YYYY_hh:mm format. 
C            * Midnight is 24:00
C   UNITT  ; Time step length and unit. Choose one of the following:
C                  1MIN
C                  2MIN
C                  3MIN
C                  4MIN
C                  5MIN
C                  10MIN
C                  15MIN
C                  20MIN
C                  30MIN
C                  1HOUR
C                  2HOUR
C                  3HOUR
C                  4HOUR
C                  6HOUR
C                  8HOUR
C                  12HOUR
C                  1DAY
C                  1WEEK
C                  1MON
C                  1YEAR
C
C-------------------------------------------------------------------------------
C       VALUE                   DESCRIPTION
C-------------------------------------------------------------------------------
     09/30/1920_24:00           / BDT 
     09/30/2015_24:00           / EDT
     1MON                       / UNITT
C******************************************************************************
C                         Physical System
C
C    NREGN  ; Number of sub-regions modeled in the system
C    NCROP  ; Number of agricultural crops modeled
C    KINFILT; Flag for the computation of the infiltration due to precipitation
C              0 = Infiltration of precipitation is computed 
C              1 = Infiltration of precipitation is read in as input; 
C                   supply infiltration of precipitation data file
C
C-----------------------------------------------------------------------------
C       VALUE                   DESCRIPTION
C-----------------------------------------------------------------------------
         230                      / NREGN
         20                       / NCROP
         1                        / KINFILT
C******************************************************************************
C                   Output Control Options
C
C    CACHE   ; Cache size in terms of number of values stored for time series data output
C    FACTAROU; Factor to convert simulation unit of area into intended output unit of area
C    UNITAROU; Output unit of area (max. 8 characters long)
C    FACTVLOU; Factor to convert simulation unit of volume into intended output unit of volume
C    UNITVLOU; Output unit of volume (max. 8 characters long)
C
C-----------------------------------------------------------------------------
C       VALUE                   DESCRIPTION
C-----------------------------------------------------------------------------
       50000000                 / CACHE  (50million)
       2.2956841E-5             / FACTAROU  
       ACRES                    / UNITAROU
       2.2956841E-5             / FACTVLOU  
       AC.FT.                   / UNITVLOU
C*******************************************************************************
C                       Agricultural Crop Codes
C   
C   The following lists the codes for each agricultural crop.  These codes are 
C   used during the print-out of the simulation results.
C
C    *Note* DO NOT enter codes for urban and native vegetation
C    
C--------------------------------------------------------------------------------
C
C   CCODE; Crop code (max. 5 characters)
C
C--------------------------------------------------------------------------------
C   VALUE                        DESCRIPTION
C--------------------------------------------------------------------------------
     AL		/ CCODE1	ALFALFA
     AP		/ CCODE2	ALMONDS AND PISTACHIO
     CO		/ CCODE3	COTTON
     CR		/ CCODE4	CORN
     CU		/ CCODE5	CUCURBITS
     DB		/ CCODE6	DRY BEANS
     FI		/ CCODE7	OTHER FIELD
     GR		/ CCODE8	GRAIN
     OG		/ CCODE9	ONIONS AND GARLIC
     OR		/ CCODE10	OTHER DECID.
     PA		/ CCODE11	PASTURE
     PO		/ CCODE12	POTATOES
     RI		/ CCODE13	RICE
     SB		/ CCODE14	SUGAR BEETS
     SF		/ CCODE15	SAFFLOWER
     SO		/ CCODE16	SUBTROPICAL
     TH		/ CCODE17	FRESH TOMATOES
     TM		/ CCODE18	PROCESS TOMATOES
     TR		/ CCODE19	OTHER TRUCK
     VI		/ CCODE20	VINEYARDS                              
