Bundle-SymbolicName: xtext-editor-ui;singleton:=true
Bundle-Name: xtext-editor-ui
Bundle-Version: 1.0.0.0
Bundle-ManifestVersion: 2.0
Bundle-Vendor: California Department of Water Resources
Bundle-RequiredExecutionEnvironment: J2SE-1.5
Bundle-ActivationPolicy: lazy
Bundle-Activator: gov.ca.dwr.wresl.xtext.editor.ui.internal.WreslEditorActivator
-noee true

Require-Bundle: \
    xtext-editor;visibility:=reexport,\
    org.eclipse.xtext.ui,\
    org.eclipse.ui.editors;bundle-version="3.5.0",\
    org.eclipse.ui.ide;bundle-version="3.5.0",\
    org.eclipse.xtext.ui.shared,\
    org.eclipse.ui,\
    org.eclipse.xtext.builder,\
    org.antlr.runtime,\
    org.eclipse.xtext.common.types.ui,\
    org.eclipse.xtext.ui.codetemplates.ui,\
    org.eclipse.compare,\
    org.eclipse.debug.core,\
    org.eclipse.debug.ui;bundle-version="3.7.0",\
    third-party;bundle-version="1.0.0"

Import-Package: \
    org.apache.log4j,\
    org.eclipse.debug.core,\
    org.eclipse.jdt.core,org.eclipse.xtext.xbase.jvmmodel,\
    org.eclipse.xtext.xbase.ui.jvmmodel.refactoring,\
    org.eclipse.xtext.xbase.ui.jvmmodel.refactoring.jdt,\
    org.eclipse.xtext.xtext.ui.refactoring,\
    gov.ca.water.wrims.gui.ide.debugger,\
    gov.ca.water.wrims.gui.ide.debugger.breakpoint,\
    gov.ca.water.wrims.gui.ide.debugger.core,\
    gov.ca.water.wrims.gui.ide.debugger.exception,\
    gov.ca.water.wrims.gui.ide.debugger.launcher,\
    gov.ca.water.wrims.gui.ide.debugger.menuitem,\
    gov.ca.water.wrims.gui.ide.debugger.model,\
    gov.ca.water.wrims.gui.ide.debugger.sourcelookup,\
    gov.ca.water.wrims.gui.ide.debugger.toolbaritem,\
    gov.ca.water.wrims.gui.ide.debugger.ui,\
    gov.ca.water.wrims.gui.ide.debugger.view,\
    gov.ca.water.wrims.gui.ide.presentation,\
    gov.ca.water.wrims.gui.ide.tools

Export-Package: \
    gov.ca.dwr.wresl.xtext.editor.ui.contentassist.antlr,\
    gov.ca.dwr.wresl.xtext.editor.ui.internal,\
    gov.ca.dwr.wresl.xtext.editor.ui.contentassist,\
    gov.ca.dwr.wresl.xtext.editor.ui.quickfix,\
    gov.ca.dwr.wresl.xtext.editor.ui.contentassist.antlr.internal

-includeresource: \
  plugin.xml = plugin.xml,\
  icons = icons

