Bundle-SymbolicName: wrims-ide;singleton:=true
Bundle-Name: wrims-ide
Bundle-Version: 1.0.0.0
Bundle-ManifestVersion: 2.0
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-Activator: gov.ca.water.wrims.gui.ide.debugger.core.DebugCorePlugin
Bundle-ActivationPolicy: lazy
-noee true

# Add GraalVM libraries to the bundle classpath
Bundle-ClassPath: .,\
    lib/graalvm-polyglot.jar,\
    lib/graalvm-python-embedding.jar,\
    lib/graalvm-python-language.jar,\
    lib/graalvm-python-resources.jar,\
    lib/graalvm-sdk.jar,\
    lib/graalvm-compiler.jar,\
    lib/graalvm-collections.jar,\
    lib/graalvm-espresso-svm.jar,\
    lib/graalvm-json.jar,\
    lib/graalvm-library-support.jar,\
    lib/graalvm-native-image.jar,\
    lib/graalvm-native-image-base.jar,\
    lib/graalvm-objectfile.jar,\
    lib/graalvm-pointsto.jar,\
    lib/graalvm-profiler-tool.jar,\
    lib/graalvm-python-language.jar,\
    lib/graalvm-regex.jar,\
    lib/graalvm-svm.jar,\
    lib/graalvm-svm-runtime.jar,\
    lib/graalvm-svm-configure.jar,\
    lib/graalvm-truffle-api.jar,\
    lib/graalvm-truffle-compiler.jar,\
    lib/graalvm-truffle-runtime.jar,\
    lib/graalvm-word.jar,\
    lib/graalvm-xz.jar

Require-Bundle: \
    org.eclipse.ui,\
    org.eclipse.core.resources,\
    org.eclipse.ui.workbench.texteditor,\
    org.eclipse.jface.text,\
    org.eclipse.ui.editors,\
    org.eclipse.ui.views.properties.tabbed,\
    org.eclipse.draw2d,\
    org.eclipse.datatools.connectivity,\
    third-party;bundle-version="1.0.0"

Import-Package: \
    org.apache.commons.io,\
    org.eclipse.core.runtime,\
    org.eclipse.core.runtime.jobs,\
    org.eclipse.core.runtime.preferences;version="3.3.0",\
    org.eclipse.debug.core,\
    org.eclipse.debug.core.model,\
    org.eclipse.debug.core.sourcelookup,\
    org.eclipse.debug.core.sourcelookup.containers,\
    org.eclipse.debug.internal.ui.views.variables,\
    org.eclipse.debug.ui,\
    org.eclipse.debug.ui.actions,\
    org.eclipse.debug.ui.console,\
    org.eclipse.debug.ui.sourcelookup,\
    org.eclipse.jdt.core,\
    org.eclipse.jface.text,\
    org.eclipse.ui,\
    org.eclipse.ui.console,\
    org.eclipse.ui.dialogs,\
    org.eclipse.ui.ide,\
    org.eclipse.ui.part,\
    org.eclipse.ui.texteditor,\
    org.osgi.framework,\
    org.graalvm.polyglot,\
    org.graalvm.collections,\
    org.graalvm.nativeimage,\
    org.graalvm.truffle,\
    org.graalvm.python

Export-Package: \
    gov.ca.water.wrims.gui.ide.debugger,\
    gov.ca.water.wrims.gui.ide.debugger.breakpoint,\
    gov.ca.water.wrims.gui.ide.debugger.commanditem,\
    gov.ca.water.wrims.gui.ide.debugger.core,\
    gov.ca.water.wrims.gui.ide.debugger.exception,\
    gov.ca.water.wrims.gui.ide.debugger.launcher,\
    gov.ca.water.wrims.gui.ide.debugger.menuitem,\
    gov.ca.water.wrims.gui.ide.debugger.model,\
    gov.ca.water.wrims.gui.ide.debugger.sourcelookup,\
    gov.ca.water.wrims.gui.ide.debugger.toolbaritem,\
    gov.ca.water.wrims.gui.ide.debugger.ui,\
    gov.ca.water.wrims.gui.ide.debugger.view,\
    gov.ca.water.wrims.gui.ide.presentation,\
    gov.ca.water.wrims.gui.ide.wsidi,\
    gov.ca.water.wrims.gui.ide.tools,\
    org.graalvm.polyglot,\
    org.graalvm.collections,\
    org.graalvm.nativeimage,\
    org.graalvm.truffle,\
    org.graalvm.python

-includeresource: \
  plugin.xml = plugin.xml,\
  icons = icons,\
  lib_x64/wrims-core.jar=build/tmp/wrims-core/wrims-core.jar;lib:=true,\
  lib/graalvm-polyglot.jar=build/tmp/graalpy/graalvm-polyglot.jar;lib:=true,\
  lib/graalvm-python-embedding.jar=build/tmp/graalpy/graalvm-python-embedding.jar;lib:=true,\
  lib/graalvm-python-language.jar=build/tmp/graalpy/graalvm-python-language.jar;lib:=true,\
  lib/graalvm-python-resources.jar=build/tmp/graalpy/graalvm-python-resources.jar;lib:=true,\
  lib/graalvm-sdk.jar=build/tmp/graalpy/graalvm-sdk.jar;lib:=true,\
