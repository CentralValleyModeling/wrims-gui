Bundle-SymbolicName: dwr-hecdssvue;singleton:=true
Bundle-Name: HEC-DSSVue in DWR
Bundle-Version: 1.0.0.0
Bundle-ManifestVersion: 2.0
Bundle-RequiredExecutionEnvironment: JavaSE-1.8
Bundle-Activator: gov.ca.water.hecdssvue.Activator
Bundle-ActivationPolicy: lazy
-noee true

Require-Bundle: \
    org.eclipse.ui,\
    org.eclipse.core.runtime,\
    org.eclipse.core.resources,\
    org.eclipse.ui.navigator,\
    org.eclipse.ui.navigator.resources,\
    third-party;bundle-version="1.0.0",\
    wrims-ide;bundle-version="1.0.0"

Import-Package: \
    org.apache.commons.logging;version="1.1.1",\
    org.eclipse.debug.core,\
    org.eclipse.jdt.core,\
    org.swixml,\
    org.swixml.converters,\
    gov.ca.water.wrims.gui.ide.debugger,\
    gov.ca.water.wrims.gui.ide.debugger.breakpoint,\
    gov.ca.water.wrims.gui.ide.debugger.core,\
    gov.ca.water.wrims.gui.ide.debugger.exception,\
    gov.ca.water.wrims.gui.ide.debugger.launcher,\
    gov.ca.water.wrims.gui.ide.debugger.menuitem,\
    gov.ca.water.wrims.gui.ide.debugger.model,\
    gov.ca.water.wrims.gui.ide.debugger.sourcelookup,\
    gov.ca.water.wrims.gui.ide.debugger.toolbaritem,\
    gov.ca.water.wrims.gui.ide.debugger.ui,\
    gov.ca.water.wrims.gui.ide.debugger.view,\
    gov.ca.water.wrims.gui.ide.presentation,\
    gov.ca.water.wrims.gui.ide.tools

Export-Package: \
    gov.ca.water.hecdssvue,\
    gov.ca.water.hecdssvue.actions,\
    gov.ca.water.hecdssvue.components,\
    gov.ca.water.hecdssvue.dialog,\
    gov.ca.water.hecdssvue.monthly,\
    gov.ca.water.hecdssvue.menus,\
    gov.ca.water.hecdssvue.perspective,\
    gov.ca.water.hecdssvue.panel,\
    gov.ca.water.hecdssvue.views

-includeresource: \
  plugin.xml = plugin.xml,\
  contexts.xml = contexts.xml,\
  icons = icons

Bundle-ClassPath: \
    .;
